<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/LangSwitch.ico</ApplicationIcon>
    <Version>1.0.2</Version>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/LangSwitch.ico" LogicalName="LangSwitch.Tray.Active.ico" />
    <EmbeddedResource Include="Assets/LangSwitch-paused.ico" LogicalName="LangSwitch.Tray.Paused.ico" />
    <InternalsVisibleTo Include="LangSwitch.Checks" />
  </ItemGroup>
</Project>
